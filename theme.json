{
  "name": "一眼DZ",
  "short": "yydz",
  "description": "一眼鉴定为真",
  "version": "1.0.5",
  "author": "kiusnax",
  "url": "https://github.com/kiusnax/monitor-theme-yydz",
  "config": [
    {
      "key": "show_summary",
      "type": "boolean",
      "label": "显示汇总",
      "default": true,
      "help": "在节点列表上方展示集群资源（CPU/内存/硬盘/类型与架构）、实时遥测、费用累计与到期排行全维度汇总看板"
    },
    {
      "key": "show_globe",
      "type": "boolean",
      "label": "显示地球拓扑",
      "default": true,
      "help": "节点列表上方的全球节点平面拓扑分布地图"
    },
    {
      "key": "show_latency",
      "type": "boolean",
      "label": "卡片显示网络延迟",
      "default": true,
      "help": "在首页监控卡片底部展示各线路延迟测试数据、走势线与丢包率"
    },
    {
      "key": "ping_lines",
      "type": "text",
      "label": "显示的延迟测试条目",
      "default": "",
      "help": "每行一个 ping 任务名称（如电信、联通、移动），或用逗号/分号分隔；留空则自动按顺序展示前 3 项"
    },
    {
      "key": "offline_placement",
      "type": "select",
      "label": "离线节点排版",
      "default": "default",
      "options": [
        {
          "label": "默认显示 (按默认顺序混排)",
          "value": "default"
        },
        {
          "label": "全部置后 (排在所有在线节点之后)",
          "value": "bottom"
        },
        {
          "label": "分区分隔显示 (在底部单设区域展示)",
          "value": "separate"
        }
      ],
      "help": "控制离线与未接入服务器在首页节点卡片网格中的展示位置与呈现策略"
    },
    {
      "key": "default_view",
      "type": "select",
      "label": "节点列表默认视图",
      "default": "card",
      "options": [
        {
          "label": "卡片",
          "value": "card"
        },
        {
          "label": "紧凑卡片",
          "value": "compact"
        },
        {
          "label": "列表（一行一台）",
          "value": "table"
        }
      ],
      "help": "访客第一次打开时用的视图；访客自己点过切换后，以他浏览器里记住的为准"
    }
  ]
}
